<?xml version="1.0"?>
<ruleset name="Prism CodeIgniter 3">
    <description>Prism PHPCS ruleset for CodeIgniter 3 application code.</description>
    <rule ref="PSR12"/>
    <exclude-pattern>*/system/*</exclude-pattern>
    <exclude-pattern>*/application/third_party/*</exclude-pattern>
    <exclude-pattern>*/application/cache/*</exclude-pattern>
    <exclude-pattern>*/application/logs/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
</ruleset>
